{
  "name": "sales-training",
  "private": true,
  "version": "0.1.0",
  "description": "TAKI SALES TRAINING — nền tảng huấn luyện đội sale bằng AI",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:all": "pnpm test && pnpm test:db",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx db/khoi-tao.ts",
    "db:seed": "tsx db/seed.ts",
    "thu:ai": "node --import tsx --conditions=react-server scripts/thu-ai.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "microsoft-cognitiveservices-speech-sdk": "1.45.0",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
