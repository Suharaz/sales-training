# Kết nối Postgres (role chủ). Local: createdb sales_training
DATABASE_URL=postgres://localhost:5432/sales_training
# Local: role app_user (không superuser) để RLS có hiệu lực; Neon không cần biến này
DATABASE_URL_APP=postgres://app_user:app_user@localhost:5432/sales_training
# Bí mật ký cookie phiên (>= 32 ký tự ngẫu nhiên)
PHIEN_SECRET=doi-chuoi-nay-thanh-bi-mat-dai-32-ky-tu
# cli = Claude CLI gói sub (máy local) · api = ANTHROPIC_API_KEY (Vercel). Thiếu cả hai → chế độ dự phòng theo luật.
AI_MODE=cli
ANTHROPIC_API_KEY=
# Model mặc định cho chế độ api
AI_MODEL=claude-sonnet-5
